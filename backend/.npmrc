# @nestjs/throttler@6.5.0 ne déclare pas encore explicitement NestJS 12 comme
# peer compatible (son peerDependencies s'arrête à ^11.0.0), bien qu'il
# fonctionne réellement avec (vérifié : voir PHASES.md phase 15). Sans ce
# réglage, tout `npm install` échoue sur ce conflit de peer dependency.
legacy-peer-deps=true
