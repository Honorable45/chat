# --- Base de données ---
DATABASE_URL="postgresql://glotta:glotta@localhost:5432/glotta?schema=public"

# --- Serveur ---
PORT=4000
# Liste séparée par des virgules — ajoutez l'origine de l'app admin
# (localhost:3001 en dev) si vous l'utilisez.
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# --- Admin (bootstrap ponctuel, voir prisma/seed.ts) ---
# Promeut ce compte (déjà inscrit normalement) au rôle ADMIN au prochain
# `npx prisma db seed` — à retirer de l'environnement une fois utilisé,
# aucun endpoint ne permet de s'auto-promouvoir.
# ADMIN_BOOTSTRAP_EMAIL=

# --- JWT ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="60d"
# Jeton du bouton "Refuser" d'une notification push d'appel entrant (voir
# CallsService.quickReject) — doit être distinct de JWT_ACCESS_SECRET.
CALL_ACTION_JWT_SECRET="change-me-call-action-secret"

# --- Email transactionnel (récupération de compte) ---
# "none" : le lien de réinitialisation est journalisé côté serveur (dev uniquement).
MAIL_PROVIDER="none"
# MAIL_API_KEY=

# --- Redis (files d'attente de traduction, cache de présence — phase 9+) ---
REDIS_URL="redis://localhost:6379"

# --- Stockage des fichiers audio/images ---
# "local" : seul driver implémenté pour les messages vocaux, qui y restent
# toujours (voir storage.service.ts). En production sur un PaaS au système
# de fichiers éphémère (Railway, Render...), STORAGE_LOCAL_PATH doit
# pointer un volume/disque persistant monté — voir DEPLOYMENT.md, sans quoi
# tout fichier vocal est perdu au prochain redéploiement. Les images/vidéos/
# avatars, eux, basculent automatiquement sur Cloudinary ci-dessous dès que
# ses 3 variables requises sont renseignées — aucun volume persistant requis
# pour ces types de médias dans ce cas. Un driver S3-compatible pour les
# vocaux reste à construire.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_REGION=

# --- Cloudinary (images/vidéos/avatars — jamais les messages vocaux, voir
# CloudinaryProvider) ---
# Optionnel, comme les fournisseurs IA ci-dessous : sans les 3 variables
# CLOUD_NAME/API_KEY/API_SECRET, tout continue sur le disque local
# (STORAGE_DRIVER ci-dessus) exactement comme avant, aucun cutover forcé.
# Compte gratuit sur cloudinary.com, identifiants sur le Dashboard.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Fournisseurs IA (voir section 38 : interchangeables, aucun mock affiché comme réel) ---
# Speech-to-Text — "none" ou "groq" (Whisper large-v3, gratuit, clé sur console.groq.com)
STT_PROVIDER="none"
# STT_API_KEY=

# Traduction texte — "none" ou "deepl" (gratuit jusqu'à 500k caractères/mois, clé sur deepl.com/pro-api)
TRANSLATION_PROVIDER="none"
# TRANSLATION_API_KEY=

# Text-to-Speech / clonage vocal (nécessite consentement explicite, section 15)
# "none" ou "elevenlabs" (seul fournisseur d'ici à proposer un vrai clonage
# vocal gratuitement — clé sur elevenlabs.io, plan Free)
TTS_PROVIDER="none"
# TTS_API_KEY=
# Voix par défaut en l'absence de modèle cloné (voix premade ElevenLabs
# "Rachel" si omis) :
# TTS_DEFAULT_VOICE_ID=

# Appels audio (WebRTC — section 20/32). Serveurs ICE renvoyés par
# GET /calls/ice-servers : un STUN suffit sur le même réseau, un TURN de
# secours est nécessaire pour la majorité des paires sur des réseaux
# différents (NAT symétrique, réseau d'entreprise...). Valeurs par défaut si
# omis : STUN public Google + TURN public gratuit "Open Relay Project"
# (openrelay.metered.ca — bande passante limitée mais suffisant pour un usage
# personnel ; passez à un TURN dédié si les appels échouent souvent en usage réel).
# STUN_URLS="stun:stun.l.google.com:19302"
# TURN_URLS="turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp"
# TURN_USERNAME="openrelayproject"
# TURN_CREDENTIAL="openrelayproject"

# --- Notifications push (PWA — notifications même app fermée) ---
# Optionnel, comme les fournisseurs ci-dessus : sans les 3 variables, les
# notifications in-app/websocket continuent de fonctionner normalement,
# simplement aucun push n'est envoyé. À générer une fois via
# `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:contact@example.com"
