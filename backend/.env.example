# --- Base de données ---
DATABASE_URL="postgresql://glotta:glotta@localhost:5432/glotta?schema=public"

# --- Serveur ---
PORT=4000
# Liste séparée par des virgules — ajoutez l'origine de l'app admin
# (localhost:3001 en dev) si vous l'utilisez.
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# --- Admin (bootstrap ponctuel, voir prisma/seed.ts) ---
# Promeut ce compte (déjà inscrit normalement) au rôle ADMIN au prochain
# `npx prisma db seed` — à retirer de l'environnement une fois utilisé,
# aucun endpoint ne permet de s'auto-promouvoir.
# ADMIN_BOOTSTRAP_EMAIL=

# --- JWT ---
# Valeurs de DÉVELOPPEMENT UNIQUEMENT (générées une fois via `openssl rand
# -hex 32`, 64 caractères, les trois distinctes) — ne jamais les réutiliser
# pour un déploiement réel, régénérez-en de nouvelles. Le serveur refuse de
# démarrer si un de ces trois secrets est absent, trop court (<32
# caractères), identique à un autre, ou égal à une valeur d'exemple connue
# (voir src/config/startup-validation.ts).
JWT_ACCESS_SECRET="473bf1dea9649acfb18e7224555047679aa78c28ef5dab2e8e092bb33fdda3c6"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="53a371512e657b24f528850fb77c556102728ab48db8bba815c5e5a010ed0e85"
JWT_REFRESH_EXPIRES_IN="60d"
# Jeton du bouton "Refuser" d'une notification push d'appel entrant (voir
# CallsService.quickReject) — doit être distinct de JWT_ACCESS_SECRET.
CALL_ACTION_JWT_SECRET="265566aeb8033f03aa5d7b2c9bbeaca62c4b972d8849c2beb67eb1acf441e6d8"

# --- Email transactionnel (récupération de compte) ---
# "none" : le lien de réinitialisation est journalisé côté serveur (dev uniquement).
MAIL_PROVIDER="none"
# MAIL_API_KEY=

# --- SMS (inscription/connexion par téléphone, voir SmsService) ---
# "none" : l'OTP est journalisé côté serveur (dev uniquement, jamais envoyé
# par SMS) — inscrivez-vous/connectez-vous en lisant le code dans les logs.
# "zavu" : envoi réel via l'API SMS Zavu (https://zavu.dev), clé ci-dessous
# requise.
SMS_PROVIDER="none"
# ZAVUDEV_API_KEY=your_api_key
# ZAVU_SENDER=your_sender_id
# Sender Zavu optionnel. Pour un sender one-way, ne forcez pas de channel SMS :
# l'API utilise automatiquement le canal configuré sur ce sender.

# Bascule temporaire (voir AuthService.isRegistrationOtpEnabled) : "false" (ou
# absent, valeur par défaut) désactive complètement la vérification OTP à
# l'INSCRIPTION uniquement — aucun SMS envoyé, aucun code demandé, le numéro
# est considéré vérifié tel quel pour laisser l'inscription se poursuivre.
# La connexion (OTP de connexion, 2FA...) n'est jamais affectée par ce
# réglage. Repasser à "true" réactive la vérification réelle sans aucune
# autre modification de code (rien n'a été supprimé côté OtpService/
# SmsService/endpoints).
# En production (NODE_ENV=production), le serveur refuse de démarrer tant
# que ceci ne vaut pas "true" ET qu'un vrai SMS_PROVIDER n'est pas configuré
# — voir src/config/startup-validation.ts. Cette bascule ne peut donc rester
# désactivée qu'en dehors de la production.
REGISTRATION_OTP_ENABLED="false"

# --- Redis (files d'attente de traduction, cache de présence — phase 9+) ---
# Le docker-compose.yml à la racine protège désormais Redis par mot de passe
# (REDIS_PASSWORD, "glotta-dev-only-change-me" par défaut en dev local) et
# ne publie plus le port que sur 127.0.0.1 — si vous l'utilisez tel quel,
# incluez ce mot de passe dans l'URL : "redis://:glotta-dev-only-change-me@localhost:6379".
# En production, utilisez l'URL (avec mot de passe) fournie par le Redis managé.
REDIS_URL="redis://localhost:6379"

# --- Stockage des fichiers audio/images ---
# "local" : seul driver implémenté pour les messages vocaux, qui y restent
# toujours (voir storage.service.ts). En production sur un PaaS au système
# de fichiers éphémère (Railway, Render...), STORAGE_LOCAL_PATH doit
# pointer un volume/disque persistant monté — voir DEPLOYMENT.md, sans quoi
# tout fichier vocal est perdu au prochain redéploiement. Les images/vidéos/
# avatars, eux, basculent automatiquement sur Cloudinary ci-dessous dès que
# ses 3 variables requises sont renseignées — aucun volume persistant requis
# pour ces types de médias dans ce cas. Un driver S3-compatible pour les
# vocaux reste à construire.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_REGION=

# --- Cloudinary (images/vidéos/avatars — jamais les messages vocaux, voir
# CloudinaryProvider) ---
# Optionnel, comme les fournisseurs IA ci-dessous : sans les 3 variables
# CLOUD_NAME/API_KEY/API_SECRET, tout continue sur le disque local
# (STORAGE_DRIVER ci-dessus) exactement comme avant, aucun cutover forcé.
# Compte gratuit sur cloudinary.com, identifiants sur le Dashboard.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Fournisseurs IA (voir section 38 : interchangeables, aucun mock affiché comme réel) ---
# Speech-to-Text — "none" ou "groq" (Whisper large-v3, gratuit, clé sur console.groq.com)
STT_PROVIDER="none"
# STT_API_KEY=

# Traduction texte — "none" ou "deepl" (gratuit jusqu'à 500k caractères/mois, clé sur deepl.com/pro-api)
TRANSLATION_PROVIDER="none"
# TRANSLATION_API_KEY=

# Text-to-Speech / clonage vocal (nécessite consentement explicite, section 15)
# "none" ou "elevenlabs" (seul fournisseur d'ici à proposer un vrai clonage
# vocal gratuitement — clé sur elevenlabs.io, plan Free)
TTS_PROVIDER="none"
# TTS_API_KEY=
# Voix par défaut en l'absence de modèle cloné (voix premade ElevenLabs
# "Rachel" si omis) :
# TTS_DEFAULT_VOICE_ID=

# Appels audio (WebRTC — section 20/32). Serveurs ICE renvoyés par
# GET /calls/ice-servers : un STUN suffit sur le même réseau, un TURN de
# secours est nécessaire pour la majorité des paires sur des réseaux
# différents (NAT symétrique, réseau d'entreprise...). Valeurs par défaut si
# omis : STUN public Google + TURN public gratuit "Open Relay Project"
# (openrelay.metered.ca — bande passante limitée mais suffisant pour un usage
# personnel ; passez à un TURN dédié si les appels échouent souvent en usage réel).
# STUN_URLS="stun:stun.l.google.com:19302"
# TURN_URLS="turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp"
# TURN_USERNAME="openrelayproject"
# TURN_CREDENTIAL="openrelayproject"

# --- Notifications push (PWA — notifications même app fermée) ---
# Optionnel, comme les fournisseurs ci-dessus : sans les 3 variables, les
# notifications in-app/websocket continuent de fonctionner normalement,
# simplement aucun push n'est envoyé. À générer une fois via
# `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:contact@example.com"

# --- Notifications push mobiles (FCM — app Flutter, y compris tuée) ---
# Optionnel, même principe que ci-dessus : sans elle, FcmProvider reste
# désactivé (web push/in-app non affectés). Valeur = le contenu ENTIER du
# fichier JSON de compte de service (Firebase Console → Paramètres du
# projet → Comptes de service → "Générer une nouvelle clé privée"), sur une
# seule ligne. Jamais le google-services.json de l'app Android (ça, c'est
# un fichier de config CLIENT, pas un secret serveur — voir mobile/android/app).
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...",...}'
