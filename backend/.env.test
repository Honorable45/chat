# Utilisé uniquement par les tests e2e (npm run test:e2e) — base séparée de
# celle du développement pour ne jamais dépendre de données créées à la
# main, et pouvoir la vider intégralement entre les runs.
DATABASE_URL="postgresql://glotta:glotta@localhost:5432/glotta_test?schema=public"
PORT=4001
CORS_ORIGIN="http://localhost:3000"

JWT_ACCESS_SECRET="test-access-secret-do-not-use-in-prod"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="test-refresh-secret-do-not-use-in-prod"
JWT_REFRESH_EXPIRES_IN="30d"
CALL_ACTION_JWT_SECRET="test-call-action-secret-do-not-use-in-prod"

REDIS_URL="redis://localhost:6379"

STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads-test"

STT_PROVIDER="none"
TRANSLATION_PROVIDER="none"
TTS_PROVIDER="none"
MAIL_PROVIDER="none"

# Désactive le rate limiting (voir app.module.ts) : une suite e2e qui
# enregistre/connecte beaucoup d'utilisateurs de suite tripperait sinon la
# vraie limite de /auth/register sans rapport avec ce qui est testé. Ne
# JAMAIS mettre cette variable dans .env ou .env.example.
DISABLE_RATE_LIMITING="true"
